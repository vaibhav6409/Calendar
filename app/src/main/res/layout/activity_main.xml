<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    tools:context=".MainActivity">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/colorPrimary"
        app:strokeWidth="1.5dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="GOVT CALENDAR 2026"
            android:textColor="@color/colorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/calendarCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerCard"
        android:layout_marginStart="2.5dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="2.5dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:strokeColor="#E0E0E0"
        app:strokeWidth="1dp">

            <com.applandeo.materialcalendarview.CalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:headerColor="@color/colorPrimary"
                app:headerLabelColor="@android:color/white"

                app:abbreviationsBarColor="@color/colorAccent"
                app:abbreviationsLabelsColor="@android:color/white"

                app:pagesColor="@android:color/white"

                app:daysLabelsColor="#333333"
                app:anotherMonthsDaysLabelsColor="#BDBDBD"

                app:selectionColor="@color/colorAccent"
                app:selectionLabelColor="@android:color/white"

                app:todayLabelColor="@color/colorAccent"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"/>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/holidayContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/calendarCard"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/customborderforholidays"
            android:orientation="vertical"
            android:padding="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" >

            <TextView
                android:id="@+id/holiday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/holo_red_light"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingVertical="3dp"
                android:padding="5dp"/>

            <TextView
                android:id="@+id/holiday1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/holo_red_light"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingVertical="3dp"
                android:padding="5dp"/>

            </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >
            <TextView
                android:id="@+id/holiday2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/holo_red_light"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingVertical="3dp"
                android:padding="5dp"/>

            <TextView
                android:id="@+id/holiday3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/holo_red_light"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingVertical="3dp"
                android:padding="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >
            <TextView
                android:id="@+id/holiday4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/holo_red_light"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingVertical="3dp"
                android:padding="5dp"/>

        </LinearLayout>

            <TextView
                android:id="@+id/sat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingVertical="3dp"
                android:padding="5dp"/>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/bottomLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:layout_marginBottom="3dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="◀"
                android:layout_margin="3dp"
                app:cornerRadius="12dp"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/colorPrimary"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/MainPage"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="2"
                android:text="मुख्य पृष्ठ"
                android:layout_margin="3dp"
                app:cornerRadius="12dp"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/colorAccent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/next"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="▶"
                android:layout_margin="3dp"
                app:cornerRadius="12dp"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/colorPrimary"/>
        </LinearLayout>

    </RelativeLayout>
